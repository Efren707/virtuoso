# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Environment variables ─────────────────────────────────────────────────────
# Never commit real .env files. Commit .env.example as a template (no real values).
.env
.env.local
.env.*.local

# ── Build output ──────────────────────────────────────────────────────────────
# Generated by Vite (frontend build)
client/dist/

# Generated by NestJS/tsc (backend build)
server/dist/

# ── TypeScript ────────────────────────────────────────────────────────────────
# Incremental compiler cache — machine-specific, not source
*.tsbuildinfo

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE / editor ──────────────────────────────────────────────────────────────
# Uncomment your editor if applicable:
# .vscode/
# .idea/

# ── Docker ────────────────────────────────────────────────────────────────────
# Local overrides (port changes, volume mounts) stay off the repo
docker-compose.override.yml
